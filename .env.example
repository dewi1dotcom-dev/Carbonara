# Copy to .env and adjust before first start.
POSTGRES_PASSWORD=change-me
APP_PORT=8080
MAX_UPLOAD_MB=30

# Statens vegvesen – technical vehicle data. Apply for a key at vegvesen.no
# (open data / "API for tekniske kjøretøyopplysninger"). Without a key the
# system works, but registry sync stays pending.
VEGVESEN_API_KEY=
# Re-sync interval for registered vehicles (days)
VEGVESEN_SYNC_DAYS=7

# Data retention: deleted cars can be restored for TRASH_DAYS, then they are
# removed for good. Cars that are off site with no activity for RETENTION_YEARS
# are deleted automatically (0 = never).
TRASH_DAYS=30
RETENTION_YEARS=5
# Only change these if Vegvesen changes their API:
#VEGVESEN_API_URL=https://akfell-datautlevering.atlas.vegvesen.no/enkeltoppslag/kjoretoydata
#VEGVESEN_AUTH_HEADER=SVV-Authorization
#VEGVESEN_AUTH_SCHEME=Apikey
